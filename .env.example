# ──────────────────────────────────────────────
# Stremio Dynamic Catalog Addon — Environment
# ──────────────────────────────────────────────

# Server
ADDON_PORT=7000
ADDON_HOST=0.0.0.0
LOG_LEVEL=info

# Redis
REDIS_URL=redis://redis:6379/0

# TMDB (required — get your key at https://www.themoviedb.org/settings/api)
# TMDB_API_KEY=your_tmdb_api_key_here
# TMDB_READ_TOKEN=your_tmdb_read_access_token_here

# Defaults
DEFAULT_LANGUAGE=pt-BR
